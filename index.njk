---
layout: base.njk
title: Kieran J. O'Leary - IP Attorney & Strategist
description: US patent attorney and IP strategist in Munich. I help people protect the things they build — and lately I've been building a few things myself.
---

<div class="home-wrapper">
  <div class="home-box">

    <!-- IMAGE COLUMN -->
    <div class="image-section">
      <div class="portrait-wrapper">
        <img src="{{ '/images/portrait.webp' | url }}" alt="Kieran O'Leary" class="portrait">
      </div>
      <div class="image-fill"></div>
    </div>

    <!-- CONTENT COLUMN -->
    <div class="content-section" id="content-section">

      <!-- Date + theme toggle -->
      <div class="content-date">
        <span class="date-text" id="date-text"></span>

        <!--
          Theme toggle button.
          theme.js writes the current-mode icon into #icon-current
          and the next-mode preview into #icon-hover on every load.
          On occasion days a third mode is added automatically.
        -->
        <button class="theme-btn" id="btn-theme" title="Switch mode">
          <svg id="icon-current" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <!-- filled by theme.js -->
          </svg>
          <svg id="icon-hover" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round"
               style="display:none">
            <!-- filled by theme.js, shown on CSS :hover -->
          </svg>
        </button>
      </div>

      <!-- Name -->
      <div class="name-header">
        <h1>Kieran J. <span class="highlight">O'Leary</span></h1>
        <p class="subtitle">US Patent Counsel &amp; IP Strategist</p>
      </div>

      <hr class="name-divider" aria-hidden="true">

      <!-- Welcome -->
      <div class="welcome">
        <h2>I help people protect the things they build &mdash; and lately I&rsquo;ve been building a few things myself.</h2>
      </div>

      <!-- Where to start -->
      <div class="where-to-start">
        <p class="where-to-start__heading">Start anywhere</p>

        <div class="nav-accordion" id="nav-accordion">

          <!-- Journal -->
          <div class="nav-item is-open">
            <div class="nav-summary" role="button" tabindex="0" aria-expanded="true">
              <span class="chevron"><svg viewBox="0 0 10 10"><polyline points="2,2 8,5 2,8"/></svg></span>
              <span class="nav-label">Latest from the journal</span>
              <a href="{{ '/blog' | url }}" class="nav-link" title="Go to Journal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              </a>
            </div>
            <div class="nav-body"><div class="nav-body-inner">
              {% if collections.posts.length > 0 %}
                {% for post in collections.posts | reverse %}
                  {% if loop.index <= 2 %}
                <div class="post-preview">
                  <a href="{{ post.url }}">{{ post.data.title }}</a>
                  <span class="date">{{ post.data.date | readableDate }}</span>
                </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                <p>No posts yet. Check back soon!</p>
              {% endif %}
              <a href="{{ '/blog' | url }}" class="more-btn">All posts &rarr;</a>
            </div></div>
          </div>

          <!-- Projects -->
          <div class="nav-item">
            <div class="nav-summary" role="button" tabindex="0" aria-expanded="false">
              <span class="chevron"><svg viewBox="0 0 10 10"><polyline points="2,2 8,5 2,8"/></svg></span>
              <span class="nav-label">What I&rsquo;m building</span>
              <a href="{{ '/projects' | url }}" class="nav-link" title="Go to Projects">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                  <polyline points="2 17 12 22 22 17"/>
                  <polyline points="2 12 12 17 22 12"/>
                </svg>
              </a>
            </div>
            <div class="nav-body"><div class="nav-body-inner">
              <p><a href="https://3pps.info" target="_blank" rel="noopener">3PPS.info</a> &mdash; a plain-English guide to USPTO preissuance submissions. Live now.</p>
              <p>Pulverhorn &mdash; the filing platform to go with it. On the workbench.</p>
              <a href="{{ '/projects' | url }}" class="more-btn">All projects &rarr;</a>
            </div></div>
          </div>

          <!-- CV / Fun facts -->
          <div class="nav-item">
            <div class="nav-summary" role="button" tabindex="0" aria-expanded="false">
              <span class="chevron"><svg viewBox="0 0 10 10"><polyline points="2,2 8,5 2,8"/></svg></span>
              <span class="nav-label">A few things about me</span>
              <a href="{{ '/about' | url }}" class="nav-link" title="Go to About">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M6 21v-1a6 6 0 0 1 12 0v1"/>
                </svg>
              </a>
            </div>
            <div class="nav-body"><div class="nav-body-inner">
              <div class="fun-facts-mini-grid">
                <div class="fun-fact-mini">
                  <span class="fun-fact-mini__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                  </span>
                  <p class="fun-fact-mini__value"><a href="{{ profile.funFacts.book.url }}" target="_blank" rel="noopener">{{ profile.funFacts.book.title }}</a></p>
                  <p class="fun-fact-mini__label">Favorite story</p>
                </div>
                <div class="fun-fact-mini">
                  <span class="fun-fact-mini__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                      <line x1="12" y1="19" x2="12" y2="23"/>
                      <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                  </span>
                  <p class="fun-fact-mini__value"><a href="{{ profile.funFacts.podcast.url }}" target="_blank" rel="noopener">{{ profile.funFacts.podcast.title }}</a></p>
                  <p class="fun-fact-mini__label">Weekend listen</p>
                </div>
                <div class="fun-fact-mini">
                  <span class="fun-fact-mini__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
                      <polyline points="17 2 12 7 7 2"/>
                    </svg>
                  </span>
                  <p class="fun-fact-mini__value"><a href="{{ profile.funFacts.show.url }}" target="_blank" rel="noopener">{{ profile.funFacts.show.title }}</a></p>
                  <p class="fun-fact-mini__label">Show I recommend</p>
                </div>
                <div class="fun-fact-mini">
                  <span class="fun-fact-mini__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="3"/>
                      <line x1="12" y1="12" x2="12.01" y2="12"/>
                    </svg>
                  </span>
                  <p class="fun-fact-mini__value"><a href="{{ profile.funFacts.album.url }}" target="_blank" rel="noopener">{{ profile.funFacts.album.title }}</a></p>
                  <p class="fun-fact-mini__label">On repeat
                    <a href="{{ profile.funFacts.album.spotify }}" target="_blank" rel="noopener" class="spotify-link" aria-label="Listen on Spotify">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M7 9.5c3.5-1.1 7-.7 9.5 1"/>
                        <path d="M7.5 12.6c2.9-.9 5.7-.5 7.9.8"/>
                        <path d="M8 15.5c2.2-.6 4.3-.3 6.1.7"/>
                      </svg>
                    </a>
                  </p>
                </div>
              </div>
              <a href="{{ '/about' | url }}" class="more-btn">More about me &rarr;</a>
            </div></div>
          </div>

        </div>
      </div>

    </div>
  </div>
  <footer class="site-footer">
    {% include "footer-content.njk" %}
  </footer>

</div>
{# No <script> tags here — base.njk handles theme.js and home.js #}
